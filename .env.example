# ═══════════════════════════════════════════
#  Sports EL — Environment Variables Template
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════

# ── Application ─────────────────────────────
APP_NAME=Sports EL
APP_ENV=development          # development | production
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars

# ── Database (PostgreSQL + TimescaleDB) ──────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sports_el
DB_USER=postgres
DB_PASSWORD=change-me-secure-password
DATABASE_URL=postgresql+asyncpg://postgres:change-me-secure-password@localhost:5432/sports_el

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ─────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── BLE / Hardware ───────────────────────────
BLE_SCAN_TIMEOUT=10           # seconds to scan for sensors
BLE_SERVICE_UUID=0x1801
BLE_IMU_CHAR_UUID=0x2A53
BLE_MAX_RECONNECT_ATTEMPTS=5

# ── Signal Processing ────────────────────────
DEFAULT_SAMPLING_RATE_HZ=100
DEFAULT_WINDOW_SIZE_SEC=5.0
DEFAULT_WINDOW_OVERLAP=0.5
DEFAULT_FILTER_CUTOFF_HZ=20.0
DEFAULT_FILTER_ORDER=4
ARTIFACT_THRESHOLD_SIGMA=5.0
ENTROPY_M_PARAM=2
ENTROPY_R_FACTOR=0.2

# ── Fatigue Thresholds (default, overridable per athlete) ──
FATIGUE_THRESHOLD_EARLY=20
FATIGUE_THRESHOLD_MODERATE=40
FATIGUE_THRESHOLD_HIGH=65

# ── File Storage (MinIO / S3) ────────────────
STORAGE_BACKEND=local         # local | minio | s3
STORAGE_LOCAL_PATH=./storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sports-el
MINIO_SECURE=false

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | text

# ── Frontend (Vite) ──────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_NAME=Sports EL
